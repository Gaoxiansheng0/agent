# Copy to .env.local for local runs. For EAS builds set the same names with `npx eas-cli env:create`.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SITE_URL=https://pearlkin.pearlwren.com
# Same value as APP_TOKEN in the server's /etc/pearlkin-api.env
EXPO_PUBLIC_APP_TOKEN=
# RevenueCat → Project settings → API keys → Public app-specific key (starts with appl_). Public by design.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
