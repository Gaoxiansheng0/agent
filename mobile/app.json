{
  "expo": {
    "name": "PearlKin",
    "slug": "pearlkin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pearlwren.pearlkin",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pearlwren.pearlkin"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "PearlKin"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "PearlKin uses the camera for your AI skin test and to scan product barcodes and ingredient labels. Photos are analyzed and not stored on our servers.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PearlKin uses a photo you choose for your AI skin test or to read a product's ingredient label.",
          "cameraPermission": "PearlKin uses the camera for your AI skin test and to scan product barcodes and ingredient labels. Photos are analyzed and not stored on our servers.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "scheme": "pearlkin",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
