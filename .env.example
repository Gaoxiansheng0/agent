# 复制为 .env 后填写。.env 不要提交、不要发给别人。

# 后端只监听本机
PORT=4320
HOST=127.0.0.1
DATA_DIR=./data

# ── 大模型：DeepSeek（OpenAI 兼容接口）。必填，没有则无法生成方案 ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 联网检索：三选一，填了 Key 的会被使用（优先级按 SEARCH_PROVIDER，留空则自动选第一个有 Key 的）──
# 不配置也能生成，但所有政策条目都会是「待确认」，市场/竞品全部标为「模型推断」。
SEARCH_PROVIDER=
# Tavily：https://tavily.com 注册即得 Key（每月有免费额度），境内访问通常需要代理
TAVILY_API_KEY=
# Serper（Google 结果）：https://serper.dev ，境内访问通常需要代理
SERPER_API_KEY=
# 博查（境内可直连，中文结果好）：https://open.bochaai.com
BOCHA_API_KEY=

# 每条检索取几条结果（越多越准，越费额度和 token）
SEARCH_RESULTS_PER_QUERY=5

# ── 代理：本地访问境外接口时使用。npm run server / dev 已带 --use-env-proxy ──
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,api.deepseek.com,api.bochaai.com
