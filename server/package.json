{
  "name": "family-shelf-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file=.env.local --watch server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test server.test.ts accounts.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
