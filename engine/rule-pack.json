  "messages": {
    "no_ingredients": "We couldn't read any ingredients for this product, so we can't call it a good fit yet. Try photographing the ingredient list.",
    "retinoid_young": "Retinoids are made for adult skin concerns like aging. Young skin rarely needs them, and they often cause dryness, peeling and irritation.",
    "retinoid_teen": "Retinoids can help teen acne, but they often irritate at first. Start slowly, and consider asking a doctor which strength fits.",
    "retinoid_pregnancy": "Retinoids are commonly avoided during pregnancy and breastfeeding. Check with your doctor before using this product.",
    "acid_young": "Exfoliating acids thin out the skin's outer layer faster than young skin needs, which can lead to redness and sensitivity.",
    "acid_teen": "Exfoliating acids can help teen skin, but daily use or layering them often causes irritation. Go easy and use sunscreen.",
    "bha_pregnancy": "Low-strength salicylic acid is often considered fine during pregnancy, but stronger peels are not. Check the strength with your doctor.",
    "acne_active_young": "This acne ingredient can be useful, but young skin usually only needs it for actual breakouts and under a doctor's guidance.",
    "vitamin_c_young": "Vitamin C serums target sun damage and dark spots that young skin rarely has, and strong ones can sting.",
    "hydroquinone_minor": "Hydroquinone is a skin-lightening ingredient for specific adult conditions and is not meant for minors.",
    "hydroquinone_adult": "In the US, hydroquinone is no longer sold over the counter. Use it only under a doctor's supervision.",
    "fragrance_young": "Fragrance is one of the most common causes of skin reactions from cosmetics. Fragrance-free options are gentler for young skin.",
    "fragrance_sensitive": "Fragrance is one of the most common causes of skin reactions from cosmetics. Look for a fragrance-free version.",
    "essential_oil": "Essential oils smell nice but are a frequent cause of irritation and allergic reactions on the skin.",
    "preservative_allergen": "This preservative is a well-known skin allergen. If anyone has had a reaction before, choose a product without it.",
    "comedogenic": "This ingredient is more likely to clog pores, which matters for acne-prone skin.",
    "routine_duplicate_exfoliants": "More than one product in this routine contains exfoliating acids. Using them together raises the chance of irritation; keep one.",
    "routine_duplicate_retinoids": "More than one product in this routine contains a retinoid. Doubling up adds irritation without extra benefit; keep one.",
    "routine_retinoid_acid": "This routine combines a retinoid with exfoliating acids. Many people use them on different nights to avoid irritation.",
    "routine_no_spf": "This morning routine has no sunscreen. Daily SPF is the most important step, especially when using active ingredients.",
    "routine_too_many": "This routine has more than 5 steps. Fewer products means fewer chances for irritation; consider simplifying."
