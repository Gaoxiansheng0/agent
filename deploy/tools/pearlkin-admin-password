#!/usr/bin/env bash
# Sets the admin panel password. Only an scrypt hash is stored in /etc/pearlkin-api.env.
set -euo pipefail
read -rsp "新的后台密码（至少 10 位，输入不显示）: " p1; echo
read -rsp "再输入一次: " p2; echo
[ "$p1" = "$p2" ] || { echo "两次不一致，未修改"; exit 1; }
[ ${#p1} -ge 10 ] || { echo "密码太短，至少 10 位"; exit 1; }
hash=$(PW="$p1" node -e 'const c=require("crypto");const s=c.randomBytes(16).toString("hex");console.log(`scrypt$${s}$${c.scryptSync(process.env.PW,s,32).toString("hex")}`)')
unset p1 p2
f=/etc/pearlkin-api.env
grep -v -E "^ADMIN_PASSWORD_HASH=" "$f" > "$f.tmp" || true
printf 'ADMIN_PASSWORD_HASH=%s\n' "$hash" >> "$f.tmp"
chmod 600 "$f.tmp" && mv "$f.tmp" "$f"
systemctl restart pearlkin-api
sleep 2
systemctl is-active pearlkin-api >/dev/null && echo "密码已设置。打开 https://pearlkin.pearlwren.com/admin 登录" || echo "服务没起来，请查看：journalctl -u pearlkin-api -n 20"
