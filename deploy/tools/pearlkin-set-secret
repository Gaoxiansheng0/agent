#!/usr/bin/env bash
# Usage: pearlkin-set-secret NAME  — prompts for the value (hidden), writes NAME=value into /etc/pearlkin-api.env, restarts the server.
set -euo pipefail
name=${1:?usage: pearlkin-set-secret NAME (e.g. DEEPSEEK_API_KEY, STRIPE_WEBHOOK_SECRET)}
[[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "名称只能是大写字母、数字和下划线"; exit 1; }
read -rsp "粘贴 $name 的值后回车（输入不显示）: " value; echo
[ -n "$value" ] || { echo "值为空，未修改"; exit 1; }
[[ "$value" != *$'\n'* ]] || { echo "值里不能有换行"; exit 1; }
f=/etc/pearlkin-api.env
touch "$f"
grep -v -E "^#? ?$name=" "$f" > "$f.tmp" || true
printf '%s=%s\n' "$name" "$value" >> "$f.tmp"
chmod 600 "$f.tmp" && mv "$f.tmp" "$f"
unset value
systemctl restart pearlkin-api
sleep 2
systemctl is-active pearlkin-api >/dev/null && echo "已保存 $name，服务已重启" || echo "服务没起来，请查看：journalctl -u pearlkin-api -n 20"
